{
  "identifier": "default",
  "description": "Default capabilities for Study Studio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "process:default",
    "dialog:default",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://api.openai.com" },
        { "url": "https://openrouter.ai" }
      ]
    },
    {
      "identifier": "fs:default",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPLOCALDATA/**" }
      ],
      "deny": [
        { "path": "$APPDATA/../**" },
        { "path": "**/node_modules/**" },
        { "path": "**/.env*" }
      ]
    }
  ]
}