{
  "name": "study-studio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev -H 0.0.0.0",
    "dev:warm": "node scripts/dev-warm.mjs",
    "build": "next build --webpack",
    "build:prod": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "lint:ci": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "test:update": "jest -u",
    "analyze": "node scripts/analyze.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:mutations": "node scripts/check-mutations.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:serial": "node scripts/verify.mjs --serial",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon",
    "ollama:pull": "ollama pull gemma3:12b && ollama pull llama3.2:3b",
    "ollama:serve": "ollama serve",
    "setup": "npm run tauri:dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
